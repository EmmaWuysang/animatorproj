e.json","version":"1.0.0"},{"enabled":true,"id":"vscode.json-language-features","version":"1.0.0"},{"enabled":false,"id":"vscode.julia","version":"1.0.0"},{"enabled":false,"id":"vscode.latex","version":"1.0.0"},{"enabled":false,"id":"vscode.less","version":"1.0.0"},{"enabled":false,"id":"vscode.log","version":"1.0.0"},{"enabled":false,"id":"vscode.lua","version":"1.0.0"},{"enabled":false,"id":"vscode.make","version":"1.0.0"},{"enabled":false,"id":"vscode.markdown","version":"1.0.0"},{"enabled":false,"id":"vscode.markdown-language-features","version":"1.0.0"},{"enabled":false,"id":"vscode.markdown-math","version":"1.0.0"},{"enabled":false,"id":"vscode.media-preview","version":"1.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"1.0.0"},{"enabled":true,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.104.0"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.10"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"1.0.0"},{"enabled":true,"id":"vscode.npm","version":"1.0.1"},{"enabled":false,"id":"vscode.objective-c","version":"1.0.0"},{"enabled":false,"id":"vscode.perl","version":"1.0.0"},{"enabled":false,"id":"vscode.php","version":"1.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"1.0.0"},{"enabled":false,"id":"vscode.powershell","version":"1.0.0"},{"enabled":false,"id":"vscode.prompt","version":"1.0.0"},{"enabled":false,"id":"vscode.pug","version":"1.0.0"},{"enabled":false,"id":"vscode.python","version":"1.0.0"},{"enabled":false,"id":"vscode.r","version":"1.0.0"},{"enabled":false,"id":"vscode.razor","version":"1.0.0"},{"enabled":false,"id":"vscode.references-view","version":"1.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"1.0.0"},{"enabled":false,"id":"vscode.ruby","version":"1.0.0"},{"enabled":false,"id":"vscode.rust","version":"1.0.0"},{"enabled":false,"id":"vscode.scss","version":"1.0.0"},{"enabled":false,"id":"vscode.search-result","version":"1.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"1.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"1.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"1.0.0"},{"enabled":false,"id":"vscode.sql","version":"1.0.0"},{"enabled":false,"id":"vscode.swift","version":"1.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"1.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"1.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"1.0.0"},{"enabled":false,"id":"vscode.typescript","version":"1.0.0"},{"enabled":true,"id":"vscode.typescript-language-features","version":"1.0.0"},{"enabled":false,"id":"vscode.vb","version":"1.0.0"},{"enabled":false,"id":"vscode.xml","version":"1.0.0"},{"enabled":false,"id":"vscode.yaml","version":"1.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":false,"id":"dracula-theme.theme-dracula","version":"2.25.1"},{"enabled":true,"id":"eamodio.gitlens","version":"19.6.0"},{"enabled":true,"id":"esbenp.prettier-vscode","version":"12.4.0"},{"enabled":false,"id":"evaera.vscode-rojo","version":"2.1.2"},{"enabled":false,"id":"fabiospampinato.vscode-monokai-night","version":"1.7.1"},{"enabled":true,"id":"GitHub.copilot","version":"1.388.0"},{"enabled":true,"id":"GitHub.copilot-chat","version":"0.31.5"},{"enabled":true,"id":"gleam.gleam","version":"2.13.0"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2025.10.2"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.12.0"},{"enabled":true,"id":"vscodevim.vim","version":"1.32.4"}]},"hash":"af7d459113889bd3efa29f640a9d786c9deddf719dddb95f1bafb69e1c5dbfa7","kind":"ext.snapshot","prev_hash":"cdcc52a94e9999d9c610d93197ff5167701291cef57c71e969be4f545aec3f17","seq":27546,"t":61068730,"wall":"2026-11-19T20:34:17.727Z"}
