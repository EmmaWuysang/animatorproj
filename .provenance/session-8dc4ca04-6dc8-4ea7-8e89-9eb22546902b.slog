"enabled":true,"id":"GitHub.copilot","version":"1.388.0"},{"enabled":true,"id":"GitHub.copilot-chat","version":"0.31.5"},{"enabled":true,"id":"gleam.gleam","version":"2.13.0"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2025.10.2"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.12.0"},{"enabled":true,"id":"vscodevim.vim","version":"1.32.4"}]},"hash":"3877ea14406d4a2d74536cf4c9b744ca5dea49f77566c085dc67706e3b9da1cf","kind":"ext.snapshot","prev_hash":"085b21e21ced348137ee2aa4635a1748fa26fac155fe6a7c38ee22bd05d3628f","seq":9488,"t":20656804,"wall":"2026-11-19T09:20:45.877Z"}
