"enabled":false,"id":"vscode.scss","version":"1.0.0"},{"enabled":false,"id":"vscode.search-result","version":"1.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"1.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"1.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"1.0.0"},{"enabled":false,"id":"vscode.sql","version":"1.0.0"},{"enabled":false,"id":"vscode.swift","version":"1.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"1.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"1.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"1.0.0"},{"enabled":false,"id":"vscode.typescript","version":"1.0.0"},{"enabled":true,"id":"vscode.typescript-language-features","version":"1.0.0"},{"enabled":false,"id":"vscode.vb","version":"1.0.0"},{"enabled":false,"id":"vscode.xml","version":"1.0.0"},{"enabled":false,"id":"vscode.yaml","version":"1.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":false,"id":"dracula-theme.theme-dracula","version":"2.25.1"},{"enabled":true,"id":"eamodio.gitlens","version":"19.6.0"},{"enabled":true,"id":"esbenp.prettier-vscode","version":"12.4.0"},{"enabled":false,"id":"evaera.vscode-rojo","version":"2.1.2"},{"enabled":false,"id":"fabiospampinato.vscode-monokai-night","version":"1.7.1"},{"enabled":true,"id":"GitHub.copilot","version":"1.388.0"},{"enabled":true,"id":"GitHub.copilot-chat","version":"0.31.5"},{"enabled":true,"id":"gleam.gleam","version":"2.13.0"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":true,"id":"ms-python.vscode-pylance","version":"2025.10.2"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.12.0"},{"enabled":true,"id":"vscodevim.vim","version":"1.32.4"}]},"hash":"6aafdcfe077e3dc6d10b26f8bb86319d776e096b99da909cffe401b948656b75","kind":"ext.snapshot","prev_hash":"4abf1a0b29afbded5d726f5b2e1afb0c4c2af53ae3a8a6e00140aaa2113e8acb","seq":37,"t":300009,"wall":"2026-11-19T03:41:29.084Z"}
